---
permalink: /
---
{%- set zones = [
  { "id": "product", "label": "Product" },
  { "id": "ai", "label": "AI" },
  { "id": "tech", "label": "Tech" },
  { "id": "games", "label": "Games" }
] -%}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<title>{{ site.author }} · Game Developer</title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="{{ site.tagline }}">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="{{ site.baseUrl }}/assets/css/cover.css">
</head>
<body data-mode="edit">
<div class="ed" id="editor">

	<!-- Toolbar -->
	<header class="bar">
		<a class="brand" href="{{ site.baseUrl }}/">
			<span class="brand-mark" aria-hidden="true"></span>
			<span class="brand-name">{{ site.author }}</span>
			<span class="brand-role">Game Developer</span>
		</a>
		<nav class="menu" aria-label="Site">
			<a href="{{ site.baseUrl }}/about/">About</a>
			<a href="{{ site.github }}" target="_blank" rel="noopener">GitHub</a>
			<a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
			<a href="mailto:{{ site.email }}">Contact</a>
		</nav>
		<div class="transport">
			<button class="play" id="btn-play" type="button" aria-pressed="false">
				<span class="play-icon" aria-hidden="true"></span><span class="play-label">Play</span>
			</button>
		</div>
		<div class="status" aria-hidden="true">
			<span>portfolio.scene</span>
			<span id="fps">-- fps</span>
		</div>
	</header>

	<!-- Hierarchy -->
	<aside class="panel hier" aria-label="Hierarchy">
		<div class="tabs"><span class="tab">Hierarchy</span></div>
		<div class="panel-body">
			<ul class="tree">
				<li><button type="button" data-select="camera"><i class="ico ico-cam"></i>Main Camera</button></li>
				<li><button type="button" data-select="player" class="sel"><i class="ico ico-player"></i>Player (Frank)</button></li>
				{%- for z in zones %}
				<li>
					<button type="button" data-select="zone:{{ z.id }}"><i class="ico ico-fold"></i>{{ z.label }} Island <em>{{ projects[z.id] | length }}</em></button>
					<ul>
						{%- for p in projects[z.id] %}
						<li><button type="button" data-select="project:{{ p.slug }}"><i class="ico ico-obj z-{{ z.id }}"></i>{{ p.title }}</button></li>
						{%- endfor %}
					</ul>
				</li>
				{%- endfor %}
				<li><button type="button" data-select="chest"><i class="ico ico-chest"></i>Treasure Chest</button></li>
			</ul>
		</div>
	</aside>

	<!-- Scene / Game view -->
	<main class="panel view">
		<div class="tabs">
			<button type="button" class="tab" id="tab-scene">Scene</button>
			<button type="button" class="tab off" id="tab-game">Game</button>
			<span class="tabs-note" id="view-note">Drag to orbit · Scroll to zoom · Click to inspect</span>
		</div>
		<div class="stage" id="stage">
			<canvas id="scene" tabindex="0" aria-label="3D scene of Frank Yang's projects. The same projects are listed in the Project panel."></canvas>

			<div class="title" id="title">
				<p class="title-kicker">Hi, I'm</p>
				<h1>{{ site.author }}</h1>
				<p class="title-tag">I make games. This portfolio is one: press Play and walk through my work.</p>
				<button class="cta" id="btn-cta" type="button"><span class="play-icon" aria-hidden="true"></span>Press Play</button>
			</div>

			<div class="loading" id="loading"><span id="loading-text">Importing assets</span><i><b id="loading-bar"></b></i></div>
			<div class="tooltip" id="tooltip" hidden></div>
			<div class="nogl">
				<p><strong>The 3D view needs WebGL.</strong><br>Everything is still here: pick a project below.</p>
			</div>

			<!-- Play mode HUD -->
			<div class="hud" id="hud">
				<div class="hud-quests">
					<div class="hud-lv"><b id="hud-lv">LV 1</b><span id="hud-rank">Visitor</span></div>
					<div class="hud-xp"><i id="hud-xp"></i></div>
					<ul>
						<li id="q-zones"><span class="box"></span>Visit every island<em>0/4</em></li>
						<li id="q-gems"><span class="box"></span>Collect the gems<em>0/12</em></li>
						<li id="q-projects"><span class="box"></span>Inspect 3 projects<em>0/3</em></li>
					</ul>
				</div>
				<button class="hud-stop" id="btn-stop" type="button"><span class="stop-icon" aria-hidden="true"></span>Stop <kbd>Esc</kbd></button>
				<div class="hud-toasts" id="toasts" aria-live="polite"></div>
				<button class="hud-prompt" id="prompt" type="button" hidden><kbd>E</kbd><span></span></button>
				<p class="hud-help"><span class="keys">WASD or arrows to move · Space to jump · Click to walk · Drag to look</span><span class="touch">Tap to walk · Drag to look around</span></p>
			</div>

			<div class="card" id="level-card" role="dialog" aria-modal="true" aria-labelledby="card-title" hidden>
				<div class="card-box">
					<img id="card-img" alt="">
					<div class="card-text">
						<p class="card-zone" id="card-zone"></p>
						<h2 id="card-title"></h2>
						<p id="card-desc"></p>
						<div class="card-actions">
							<a class="btn primary" id="card-open" href="#">Open project</a>
							<button class="btn" id="card-close" type="button">Keep exploring</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<!-- Inspector -->
	<aside class="panel insp" aria-label="Inspector">
		<div class="tabs"><span class="tab">Inspector</span></div>
		<div class="panel-body" id="inspector">
			<div class="insp-head">
				<img class="insp-face" src="{{ site.baseUrl }}/images/profile_pic.jpg" alt="{{ site.author }}">
				<div><strong>{{ site.author }}</strong><small>Game Developer</small></div>
			</div>
			<section class="comp">
				<h3>About</h3>
				<div class="comp-body">
					<p>{{ site.tagline }}</p>
					<a class="btn" href="{{ site.baseUrl }}/about/">About me</a>
				</div>
			</section>
		</div>
	</aside>

	<!-- Project browser + console -->
	<section class="panel dock">
		<div class="tabs">
			<button type="button" class="tab" id="tab-project">Project</button>
			<button type="button" class="tab off" id="tab-console">Console</button>
			<span class="tabs-note" id="crumb">Assets / Projects</span>
		</div>
		<div class="dock-body" id="dock-project">
			<ul class="folders" id="folders">
				<li><button type="button" class="on" data-folder="all"><i class="ico ico-fold"></i>All</button></li>
				{%- for z in zones %}
				<li><button type="button" data-folder="{{ z.id }}"><i class="ico ico-fold z-{{ z.id }}"></i>{{ z.label }}</button></li>
				{%- endfor %}
			</ul>
			<div class="assets" id="assets">
				{%- for z in zones %}{%- for p in projects[z.id] %}
				<a class="asset" href="{{ site.baseUrl }}/projects/{{ p.slug }}/" data-entity="project:{{ p.slug }}" data-zone="{{ z.id }}" title="{{ p.description }}">
					<span class="asset-img z-{{ z.id }}"><img src="{{ site.baseUrl }}/images/cover/{{ p.slug }}.jpg" alt="" loading="lazy" width="96" height="96"></span>
					<span class="asset-name">{{ p.title }}</span>
				</a>
				{%- endfor %}{%- endfor %}
			</div>
		</div>
		<div class="dock-body console" id="dock-console" hidden>
			<div class="console-log" id="console-log" role="log"></div>
			<form class="console-in" id="console-form" autocomplete="off">
				<label for="console-input">&gt;</label>
				<input id="console-input" type="text" placeholder="Type help" spellcheck="false">
			</form>
		</div>
	</section>
</div>

<script id="cover-data" type="application/json">{{ { "base": site.baseUrl, "projects": projects, "author": site.author, "tagline": site.tagline, "email": site.email, "github": site.github, "linkedin": site.linkedin, "twitter": site.twitter } | dump | safe }}</script>
<script type="module" src="{{ site.baseUrl }}/assets/js/cover.js"></script>
</body>
</html>
